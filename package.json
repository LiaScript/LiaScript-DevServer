{
  "name": "@liascript/devserver",
  "version": "1.3.0--2.6.2",
  "description": "Run a development server for LiaScript locally",
  "main": "dist/index.js",
  "scripts": {
    "build": "npx parcel build src/index.ts --target main && npx parcel build --target teachers && npm run shebang && npm run lib && cp src/codex-bridge.js dist/codex-bridge.js",
    "lib": "tsc --module commonjs -d src/lib.ts --outDir dist",
    "codex": "node dist/codex-bridge.js",
    "test:mcp": "node src/check.js",
    "test:codex": "node src/check-codex.js",
    "shebang": "head -c2 dist/index.js | grep -q '#!' || sed -i '1i #!/usr/bin/env node\\n' dist/index.js && chmod +x dist/index.js",
    "release": "npm run release_win && npm run release_linux && npm run release_macos",
    "release_win": "pkg . -t node18-win --output release/windows/liascript-devserver -C GZip",
    "release_linux": "pkg . -t node18-linux --output release/linux/liascript-devserver -C GZip",
    "release_macos": "pkg . -t node18-macos --output release/macos/liascript-devserver -C GZip"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/LiaScript/LiaScript-DevServer.git"
  },
  "bugs": {
    "url": "https://github.com/LiaScript/LiaScript-DevServer/issues",
    "email": "LiaScript@web.de"
  },
  "homepage": "https://github.com/LiaScript/LiaScript-DevServer/blob/main/README.md",
  "bin": {
    "liascript-devserver": "dist/index.js",
    "liadev": "dist/index.js",
    "liascript-codex": "dist/codex-bridge.js"
  },
  "preferGlobal": true,
  "keywords": [
    "LiaScript",
    "OER",
    "Markdown",
    "devServer"
  ],
  "author": "André Dietrich",
  "license": "MIT",
  "dependencies": {
    "@liascript/editor": "^1.2.0--2.6.2",
    "body-parser": "^1.20.4",
    "chokidar": "^4.0.3",
    "cors": "^2.8.6",
    "express": "^4.22.1",
    "express-handlebars": "^5.3.5",
    "ip": "^2.0.1",
    "minimist": "^1.2.8",
    "open": "^8.4.2",
    "reload": "^3.3.0"
  },
  "devDependencies": {
    "@dicebear/avataaars": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@dicebear/lorelei": "^9.4.2",
    "@dicebear/micah": "^9.4.2",
    "@dicebear/notionists": "^9.4.2",
    "@dicebear/personas": "^9.4.2",
    "@dicebear/toon-head": "^9.4.2",
    "@types/express": "^4.17.25",
    "@types/node": "^25.2.3",
    "parcel": "^2.16.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">= 12"
  },
  "targets": {
    "main": {
      "context": "node",
      "optimize": true
    },
    "teachers": {
      "source": "src/teachers/teachers.ts",
      "distDir": "views",
      "context": "browser",
      "outputFormat": "global",
      "includeNodeModules": true,
      "sourceMap": false,
      "optimize": true
    }
  },
  "pkg": {
    "assets": [
      "node_modules/@liascript/editor/dist/**/*",
      "node_modules/@liascript/chat/dist/**/*",
      "views/**/*"
    ]
  },
  "allowScripts": {
    "msgpackr-extract@3.0.3": true,
    "@parcel/watcher@2.5.6": true,
    "lmdb@2.8.5": true,
    "es5-ext@0.10.64": true,
    "@swc/core@1.15.11": true
  }
}
